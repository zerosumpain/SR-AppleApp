<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>SR Companion</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict/>
<!-- The app is light-locked in SwiftUI with `.preferredColorScheme(.light)`,
     which covers the view hierarchy and NOT the surfaces UIKit presents for it:
     an action sheet, an alert, the share sheet, the camera picker. On a phone
     set to dark those still came up dark, in the middle of a cream app. This is
     the declaration that covers them. The site has no dark mode; inverting a
     palette whose counter-accent has no on-ink value would drop a third of its
     semantic vocabulary, not restyle it. -->
<key>UIUserInterfaceStyle</key><string>Light</string>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>NSHealthUpdateUsageDescription</key><string>SR Companion reads your selected Apple Health data for your private dashboard. It does not write or change data in Apple Health.</string>
<key>NSCameraUsageDescription</key><string>Scan the pairing QR code at strangeramblings.com/welcome to connect this iPhone, and take photos to send to jkai.</string>
<key>NSHealthShareUsageDescription</key><string>Sync the Apple Health categories you choose — activity, heart, overnight vitals, fitness, workouts with their routes, sleep, mobility, body and lifestyle — to your private Strange Ramblings health dashboard. Nothing is shared with anyone else.</string>
<key>NSLocationWhenInUseUsageDescription</key><string>Share your current location with members of your Strange Ramblings family.</string>
<key>NSLocationAlwaysAndWhenInUseUsageDescription</key><string>Keep your family location updated when the app is closed, using more frequent records while moving. You can pause sharing at any time.</string>
<key>NSMotionUsageDescription</key><string>Read the movement your iPhone has already recorded, so location can be switched off while you are sitting still and switched back on when you actually go somewhere. It is only read to decide that.</string>
<key>NSLocalNetworkUsageDescription</key><string>Connect to your Strange Ramblings test server on your local network.</string>
<key>UIBackgroundModes</key><array><string>location</string><string>fetch</string><string>processing</string></array>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.strangeramblings.com.appleapp.refresh</string></array>
<key>UIAppFonts</key><array><string>ArchivoBlack-Regular.ttf</string><string>DMSans-Regular.ttf</string><string>DMSans-Medium.ttf</string><string>DMSans-Bold.ttf</string><string>DMMono-Regular.ttf</string><string>DMMono-Medium.ttf</string><string>JetBrainsMono-Regular.ttf</string><string>JetBrainsMono-Medium.ttf</string><string>JetBrainsMono-Bold.ttf</string></array>
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>NSMicrophoneUsageDescription</key><string>Record a voice note to send to jkai. Nothing is recorded unless you hold the microphone button.</string>
<key>LSSupportsOpeningDocumentsInPlace</key><false/>
<key>CFBundleDocumentTypes</key><array><dict><key>CFBundleTypeName</key><string>Files for jkai</string><key>CFBundleTypeRole</key><string>Viewer</string><key>LSHandlerRank</key><string>Alternate</string><key>LSItemContentTypes</key><array><string>public.image</string><string>com.adobe.pdf</string><string>public.plain-text</string><string>public.comma-separated-values-text</string><string>public.json</string><string>net.daringfireball.markdown</string><string>org.openxmlformats.wordprocessingml.document</string><string>org.openxmlformats.spreadsheetml.sheet</string><string>public.rtf</string><string>public.mpeg-4-audio</string></array></dict></array>
</dict></plist>
